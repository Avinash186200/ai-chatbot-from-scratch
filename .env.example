# Copy to .env and fill in. Never commit .env.
# Every setting is documented in docs/operations.md.

# ---- Required for the Docker stack -----------------------------------------
# Bearer token for /gateway/*, /api/* and /mcp. With none set, every request is refused.
AA_GATEWAY_TOKEN=change-me-local-token
# Postgres (pgvector) password for the compose stack.
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_USER=assistant
POSTGRES_DB=assistant
# Host ports nginx publishes on 127.0.0.1.
AA_HTTPS_PORT=8443
AA_HTTP_PORT=8080

# ---- Server (laptop defaults; compose overrides paths and hosts) ----------
AA_HOST=127.0.0.1
AA_PORT=8000
AA_DB_PATH=analytics_assistant.db
AA_SYNTHETIC_SEED=7
# Conversation index + graph checkpoints when no AA_DATABASE_URL.
AA_STATE_DB=assistant_state.db
# PostgreSQL URL: pgvector store + LangGraph checkpoints. Empty = SQLite/in-memory.
AA_DATABASE_URL=
# Serve the built web UI at / (e.g. web/dist). Empty = minimal static page.
AA_WEB_DIST=

# ---- Agent ------------------------------------------------------------------
# "loop" (default in-process tool loop) or "graph" (LangGraph state graph).
AA_AGENT=loop
AA_AGENT_MAX_STEPS=6

# ---- LLM ----------------------------------------------------------------------
# "scripted" runs offline; "openai_compatible" calls <base>/chat/completions;
# "anthropic" calls <base>/v1/messages.
AA_LLM_PROVIDER=scripted
AA_LLM_BASE_URL=http://localhost:11434/v1
AA_LLM_MODEL=
AA_LLM_API_KEY=
AA_LLM_TIMEOUT_S=60
AA_LLM_MAX_RETRIES=3
# Optional second provider, used only when the first fails.
AA_LLM_FALLBACK_PROVIDER=
AA_LLM_FALLBACK_BASE_URL=
AA_LLM_FALLBACK_MODEL=
AA_LLM_FALLBACK_API_KEY=
# Prices per million tokens for the cost counter (0 = not tracked).
AA_LLM_PRICE_IN_PER_MTOK=0
AA_LLM_PRICE_OUT_PER_MTOK=0

# ---- Retrieval ----------------------------------------------------------------
# "hashing" (offline default) or "sentence-transformers" (needs the embeddings extra).
AA_EMBEDDER=hashing
AA_EMBEDDING_MODEL=all-MiniLM-L6-v2
AA_RAG_MIN_SCORE=0.12
# Extra .md/.txt/.pdf documents to ingest into the "documents" collection.
AA_DOCS_DIR=

# ---- Observability --------------------------------------------------------------
# "console" (default), "otlp" (needs the otel extra; AA_OTEL_ENDPOINT), or "none".
AA_OTEL_EXPORTER=console
AA_OTEL_ENDPOINT=
AA_LOG_FORMAT=json
AA_LOG_LEVEL=INFO

# ---- MCP over HTTP ----------------------------------------------------------------
AA_MCP_PORT=8001
AA_MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*

# Browser origins allowed to call the gateway directly (the Excel add-in dev server).
AA_CORS_ORIGINS=https://localhost:3000
